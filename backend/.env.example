# AuraEdit AI - Backend Configuration Environment Variables
PROJECT_NAME="AuraEdit AI"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY="auraedit-super-secret-key-change-in-production-environments"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL="sqlite:///./auraedit.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql://aura_user:aura_password@localhost:5432/auraedit_db"

# AI Agent & Google Gemini API
GEMINI_API_API_KEY="YOUR_GEMINI_API_KEY_HERE"
DEFAULT_AI_MODEL="gemini-3.5-flash"
VIDEO_AI_MODEL="gemini-omni-1.1-flash"
VIDEO_MODEL_ENDPOINT="gemini-omni-1.1-flash"
IMAGE_GENERATION_MODEL="gemini-3.1-flash-image"
IMAGE_MODEL_ENDPOINT="gemini-3.1-flash-image"

# File Storage Setup
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
